<header class="site-header" data-header>
  <div class="wrap header-inner">
    <a class="brand" href="{{ '/' | relative_url }}" aria-label="Muhammad Talha, home">
      <span class="brand-text">
        <span class="brand-name">{{ site.author.name }}</span>
        <span class="brand-sub">{{ site.tagline }}</span>
      </span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Main" data-nav>
      <ul>
        {% for item in site.nav %}
          {% assign active = false %}
          {% if page.url == item.url %}{% assign active = true %}{% endif %}
          {% if item.url == '/projects/' and page.collection == 'projects' %}{% assign active = true %}{% endif %}
          <li>
            <a
              href="{{ item.url | relative_url }}"
              {% if active %}
                class="is-active" aria-current="page"
              {% endif %}
            >
              {{- item.title -}}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="header-actions">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch between light and dark theme">
        {% include icon.liquid name="sun" class="when-dark" %}
        {% include icon.liquid name="moon" class="when-light" %}
      </button>
      <button class="icon-btn nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
        {% include icon.liquid name="menu" class="when-closed" %}
        {% include icon.liquid name="close" class="when-open" %}
      </button>
    </div>
  </div>
</header>
