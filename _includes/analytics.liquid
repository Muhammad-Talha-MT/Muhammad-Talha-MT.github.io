{%- comment -%}
  Privacy-friendly visit counts via GoatCounter (no cookies, no personal data).
  Active only when analytics.goatcounter is set in _config.yml, and never on local previews.
{%- endcomment -%}
{%- if site.analytics.goatcounter and site.analytics.goatcounter != '' and jekyll.environment == 'production' -%}
  <script data-goatcounter="https://{{ site.analytics.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
{%- endif -%}
