---
layout: default
---
<header class="page-hero">
  <div class="wrap">
    {% if page.eyebrow %}
      <p class="section-kicker">{{ page.eyebrow }}</p>
    {% endif %}
    <h1 class="page-title">{{ page.heading | default: page.title }}</h1>
    {% if page.description %}
      <p class="page-lede">{{ page.description }}</p>
    {% endif %}
  </div>
</header>
<div class="wrap page-body{% if page.prose %} prose{% endif %}">
  {{ content }}
</div>
