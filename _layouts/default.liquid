<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
  </head>
  <body class="{{ page.body_class | default: 'page' }}">
    <a class="skip-link" href="#main">Skip to content</a>
    {% include header.liquid %}
    <main id="main">
      {{ content }}
    </main>
    {% include footer.liquid %}
    <script src="{{ '/assets/js/site.js' | relative_url }}?v={{ site.time | date: '%s' }}" defer></script>
    {% include analytics.liquid %}
    {% for script in page.scripts %}
      <script src="{{ script | relative_url }}?v={{ site.time | date: '%s' }}" defer></script>
    {% endfor %}
  </body>
</html>
