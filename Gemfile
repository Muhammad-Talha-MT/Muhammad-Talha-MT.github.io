source 'https://rubygems.org'

gem 'jekyll', '~> 4.4'

group :jekyll_plugins do
  gem 'jekyll-scholar'   # renders _bibliography/papers.bib
  gem 'jekyll-seo-tag'   # <title>, description, Open Graph, JSON-LD
  gem 'jekyll-sitemap'
  gem 'jemoji'
end

# Runtime dependencies no longer bundled with Ruby 3.4+
gem 'observer'  # used by jekyll-scholar
gem 'csv'
gem 'bigdecimal'
gem 'logger'
